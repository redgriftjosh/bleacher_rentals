{
  "info": {
    "name": "API Security Tests",
    "description": "Test auth guards on all API routes.\n\n**Setup:**\n1. Go to Variables tab and set `base_url`\n2. Log in as admin in browser, run `await window.Clerk.session.getToken()` in console, paste into `admin_token`\n3. Log in as AM, do the same, paste into `am_token`\n\nTokens expire in ~60s — refresh as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "am_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "connection_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Admin-Only Routes",
      "description": "These routes require `requireAdmin()`. Admin → 200, AM → 403, No token → 401.",
      "item": [
        {
          "name": "QBO Connections",
          "item": [
            {
              "name": "GET connections (admin)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{admin_token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/quickbooks/connections",
                  "host": ["{{base_url}}"],
                  "path": ["api", "quickbooks", "connections"]
                }
              }
            },
            {
              "name": "GET connections (AM — expect 403)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{am_token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/quickbooks/connections",
                  "host": ["{{base_url}}"],
                  "path": ["api", "quickbooks", "connections"]
                }
              }
            },
            {
              "name": "GET connections (no token — expect 401)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/quickbooks/connections",
                  "host": ["{{base_url}}"],
                  "path": ["api", "quickbooks", "connections"]
                }
              }
            },
            {
              "name": "POST connections (admin)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{admin_token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"displayName\": \"Postman Test Connection\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/quickbooks/connections",
                  "host": ["{{base_url}}"],
                  "path": ["api", "quickbooks", "connections"]
                }
              }
            },
            {
              "name": "POST connections (AM — expect 403)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{am_token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"displayName\": \"Postman Test Connection\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/quickbooks/connections",
                  "host": ["{{base_url}}"],
                  "path": ["api", "quickbooks", "connections"]
                }
              }
            },
            {
              "name": "PATCH connections (AM — expect 403)",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{am_token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connectionId\": \"{{connection_id}}\",\n  \"displayName\": \"Hacked Name\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/quickbooks/connections",
                  "host": ["{{base_url}}"],
                  "path": ["api", "quickbooks", "connections"]
                }
              }
            },
            {
              "name": "DELETE connections (AM — expect 403)",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{am_token}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/quickbooks/connections?connectionId={{connection_id}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "quickbooks", "connections"],
                  "query": [
                    {
                      "key": "connectionId",
                      "value": "{{connection_id}}"
                    }
                  ]
                }
              }
            }
          ]
        },
